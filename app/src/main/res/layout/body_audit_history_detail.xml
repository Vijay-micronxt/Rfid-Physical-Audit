<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/rfid_screen_padding">

    <TextView
        android:id="@+id/historyDetailTitle"
        style="@style/TextAppearance.Rfid.SectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/historyDetailMeta"
        style="@style/TextAppearance.Rfid.HelperMetaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/historyDetailSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/rfid_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/rfid_surface_variant"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Item"
            android:textColor="@color/rfid_on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Scanned"
            android:textColor="@color/rfid_on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Site"
            android:textColor="@color/rfid_on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Diff"
            android:textColor="@color/rfid_on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/historyDetailList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/historyDetailUnknown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:padding="10dp"
        android:textColor="@color/rfid_error"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
