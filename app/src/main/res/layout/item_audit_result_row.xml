<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/auditRowName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/rfid_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/auditRowMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/rfid_on_surface"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/auditRowScanned"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/rfid_secondary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/auditRowSite"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/rfid_on_surface"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/auditRowDiff"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
