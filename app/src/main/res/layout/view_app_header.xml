<?xml version="1.0" encoding="utf-8"?>
<!-- The top bar of every screen. Kept slim: title on the left, the warning and theme icons on the right. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="2dp"
    app:cardCornerRadius="@dimen/rfid_radius_large"
    app:cardBackgroundColor="@color/rfid_header_surface"
    app:cardElevation="2dp"
    app:strokeColor="@color/rfid_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rfid_luxury_header_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp">
        <ImageButton
            android:id="@+id/appHeaderBackButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_navigate_back"
            android:padding="4dp"
            android:src="@drawable/ic_chevron_left"
            android:tint="?attr/colorOnSurface"
            android:visibility="gone" />

        <TextView
            android:id="@+id/appHeaderTitle"
            style="@style/TextAppearance.Rfid.SectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="16sp"
            android:text="@string/header_title_placeholder" />

        <TextView
            android:id="@+id/appHeaderSubtitle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="@string/header_subtitle_placeholder" />

        <ImageButton
            android:id="@+id/issueCenterButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_open_issues"
            android:padding="7dp"
            android:src="@android:drawable/stat_notify_error"
            android:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/themeModeButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_toggle_theme"
            android:padding="7dp"
            android:src="@drawable/ic_theme_sun"
            android:tint="?attr/colorOnSurface" />

        <!-- Far right. Hidden unless a screen asks for it (see BaseScreenFragment.onHeaderSettings). -->
        <ImageButton
            android:id="@+id/headerSettingsButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:padding="7dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="?attr/colorOnSurface"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/appHeaderActionSlot"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
